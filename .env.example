# Example environment variables for local development
# Copy this file to `.env` and fill in the real values.

# DatoCMS read-only API token (used by src/lib/datocms.ts)
VITE_DATO_API_TOKEN=your_dato_api_token_here

# DatoCMS environment (e.g. main)
VITE_DATO_ENVIRONMENT=main

# Base URL for the contact API (used by src/services/api.ts)
VITE_API_BASE_URL=https://example.com/server/contactapi/

# Cloudflare Turnstile site key (used by the contact form)
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key_here
